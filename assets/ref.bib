@INPROCEEDINGS{Randell92rcc,
  author = {Randell, David A. and Cui, Zhan and Cohn, Anthony G.},
  title = {{A} {s}patial {l}ogic {b}ased on {r}egions and {c}onnection},
  booktitle = {{KR}'92: Principles of Knowledge Representation and Reasoning},
  year = {1992},
  pages = {165--176},
  abstract = {We describe an interval logic for reasoning about space. The logic
	simplifies an earlier theory developed by Randell and Cohn, and that
	of Clarke upon which the former was based. The theory supports a
	simpler ontology, has fewer defined functions and relations, yet
	does not suffer in terms of its useful expressiveness. An axiomatisation
	of the new theory and a comparison with the two original theories
	is given.},
  comment = {RCC Theory proposed with comparison to earlier versions (in LLAMA)
	and Clarke's theory.
	
	Sorted logic: REGION, SPATIAL, NULL, (ATOM)
	
	
	- main argument for not distinguishing open, semi-open, and closed
	regions: odd, because they occupy the sam region (just different
	boundaries)
	
	- region and its complement are always connected
	
	- definition of inclusion and containment relations by convex hull
	-> forms RCC-22 (RCC-23)
	
	- further potential distinction: geometrically inside vs. topologically
	inside
	
	- rules out infinite unions (otherwise inconsistency arises: follows
	from supplementation principle and atomless assumption; if a region
	is the infinite union of its nontangential proper parts it would
	need to externally connect with its complement, which is disallowed
	by non of the NTPP to be externally connected to the complement of
	the element it is NTPP of)
	
	- optionally (but assumed the standard case): existence of NTPP for
	every (proper) region -> atomless theory
	
	- discussion of alternative, atomic versions:
	
	(1) Atoms as primitive sorts, with NTPP that are of sort particle;
	particles do not occur in regions directly
	
	(2) Taking atoms and summation as primitive sort and function, define
	the part/whole relation in terms of summed regions
	
	(3) Atoms as defined sorts, introduce points as primitive sorts, use
	a primitive relation IN between points and regions instead of C,
	define C in terms of IN},
  journal = {KR},
  keywords = {RCC, mereotopology, atom},
  leeds_file = {KR92.ps},
  owner = {torsten},
  print = {x},
  read = {R},
  timestamp = {2007.03.22}
}

