@ARTICLE{Duentsch-ApplicationsRelationAlgebras-05,
  author = {Ivo D{\" u}ntsch},
  title = {{R}elation algebras and their application in temporal and spatial
	reasoning},
  journal = {Artif. Intell. Rev.},
  year = {2005},
  volume = {23},
  pages = {315--357},
  number = {4},
  abstract = {Qualitative temporal and spatial reasoning is in many cases based
	on binary relations such as before, after, starts, contains, contact,
	part of, and others derived from these by relational operators. The
	calculus of relation algebras is an equational formalism; it tells
	us which relations must exist, given several basic operations, such
	as Boolean operations on relations, relational composition and converse.
	Each equation in the calculus corresponds to a theorem, and, for
	a situation where there are only finitely many relations, one can
	construct a composition table which can serve as a look up table
	for the relations involved. Since the calculus handles relations,
	no knowledge about the concrete geometrical objects is necessary.
	In this sense, relational calculus is "pointless". Relation algebras
	were introduced into temporal reasoning by Allen (1983, Communications
	of the ACM 26(1), 832--843) and into spatial reasoning by Egenhofer
	and Sharma (1992, Fifth Int. Symposium on Spatial Data Handling,
	Charleston, SC). The calculus of relation algebras is also well suited
	to handle binary constraints as demonstrated e.g. by Ladkin and Maddux
	(1994, Journal of the ACM 41(3), 435--469). In the present paper
	I will give an introduction to relation algebras, and an overview
	of their role in qualitative temporal and spatial reasoning.},
  keywords = {relation algebras},
  owner = {torsten},
  read = {T},
  relevance = {I?},
  timestamp = {2009.04.30}
}

