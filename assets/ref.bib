@ARTICLE{Clementini-TopologicalInvariants-98,
  author = {Clementini,, Eliseo and Di Felice,, Paolino},
  title = {{T}opological invariants for lines},
  journal = {{IEEE} Trans. Knowl. Data Eng.},
