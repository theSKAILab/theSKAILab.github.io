  pages = {221--226},
  abstract = {Various intelligent systems rely heavily on formalisms for spatial
	representation and reasoning. However, it is widely recognized that
	real-world regions are seldom characterized by a precisely defined
	boundary. This paper proposes a generalization of the Region Connection
	Calculus (RCC) which allows to define spatial relations between vague
