  title = {Basic Concepts of Formal Ontology},
  booktitle = {Conf. on Formal Ontology in Inf. Systems (FOIS-98)},
  year = {1998},
  pages = {19--28},
  publisher = {IOS Press},
  abstract = {The term â€˜formal ontologyâ€™ was first used by the philosopher Edmund
	
	Husserl in his Logical Investigations to signify the study of those
	formal
	
	structures and relations â€“ above all relations of part and whole
	â€“ which are
	
	exemplified in the subject-matters of the different material sciences.
	We
	
	follow Husserl in presenting the basic concepts of formal ontology
	as
	
	falling into three groups: the theory of part and whole, the theory
	of
	
	dependence, and the theory of boundary, continuity and contact. These
	
