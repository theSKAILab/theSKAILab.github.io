	Cruz-Lara, Samuel and Mahfoudh, Mariem},
  title = {Mapping Natural Language to Description Logic},
  booktitle = {The Semantic Web},
  year = {2017},
  editor = {Blomqvist, Eva and Maynard, Diana and Gangemi, Aldo and Hoekstra,
	Rinke and Hitzler, Pascal and Hartig, Olaf},
  pages = {273--288},
  address = {Cham},
  publisher = {Springer International Publishing},
  abstract = {While much work on automated ontology enrichment has focused on mining
	text for concepts and relations, little attention has been paid to
	the task of enriching ontologies with complex axioms. In this paper,
	we focus on a form of text that is frequent in industry, namely system
	installation design principle (SIDP) and we present a framework which
	can be used both to map SIDPs to OWL DL axioms and to assess the
	quality of these automatically derived axioms. We present experimental
	results on a set of 960 SIDPs provided by Airbus which demonstrate
	(i) that the approach is robust (97.50{\%} of the SIDPs can be parsed)
	and (ii) that DL axioms assigned to full parses are very likely to
	be correct in 96{\%} of the cases.},
  isbn = {978-3-319-58068-5}
}

